{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Law Article Schema",
  "description": "ساختار استاندارد برای ذخیره مواد قانونی در سیستم دادرس",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "article_number",
      "title",
      "text",
      "explanation",
      "tags",
      "category",
      "status"
    ],
    "properties": {
      "article_number": {
        "type": "integer",
        "minimum": 1,
        "description": "شماره ماده قانونی"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "عنوان کوتاه ماده"
      },
      "text": {
        "type": "string",
        "minLength": 10,
        "description": "متن کامل ماده قانونی"
      },
      "explanation": {
        "type": "string",
        "minLength": 10,
        "description": "توضیح ساده و کاربردی"
      },
      "examples": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "مثال‌های کاربردی"
      },
      "key_points": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "نکات کلیدی و مهم"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[^#]+$"
        },
        "minItems": 1,
        "description": "برچسب‌ها بدون # در ابتدا"
      },
      "related_articles": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "description": "شماره مواد مرتبط"
      },
      "references": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "منابع و مراجع"
      },
      "category": {
        "type": "string",
        "minLength": 1,
        "description": "دسته اصلی (مثل معاملات، اموال)"
      },
      "subcategory": {
        "type": "string",
        "description": "زیردسته (مثل عقود، مالکیت)"
      },
      "status": {
        "type": "string",
        "enum": ["active", "deprecated", "modified", "repealed"],
        "description": "وضعیت ماده: active (فعال), deprecated (منسوخ), modified (اصلاح‌شده), repealed (لغوشده)"
      },
      "last_modified": {
        "type": "string",
        "pattern": "^\\d{4}/\\d{2}/\\d{2}$",
        "description": "تاریخ آخرین تغییر به صورت YYYY/MM/DD"
      },
      "notes": {
        "type": "string",
        "description": "یادداشت‌های اضافی"
      }
    }
  }
}

